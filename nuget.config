<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <!-- Beutl packages built from a Beutl checkout, for APIs that no release ships yet. -->
    <add key="Beutl worktree" value="artifacts/sdk" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="nuget.beditor.net" value="https://nuget.beditor.net/v3/index.json" />
  </packageSources>
</configuration>
