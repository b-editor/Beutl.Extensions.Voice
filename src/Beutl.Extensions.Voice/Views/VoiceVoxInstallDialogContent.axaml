<UserControl x:Class="Beutl.Extensions.Voice.Views.VoiceVoxInstallDialogContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:Beutl.Extensions.Voice.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModels:VoiceVoxInstallDialogViewModel"
             mc:Ignorable="d">
    <StackPanel Spacing="12">
        <Carousel Name="Root">
            <StackPanel Spacing="4">
                <TextBlock Text="外部エンジンだけを使う場合はスキップできます。" TextWrapping="Wrap" />
                <TextBlock Text="インストール前にVOICEVOX公式サイトの利用規約をご確認ください。" TextWrapping="Wrap" />
                <HyperlinkButton Content="VOICEVOX公式サイト" NavigateUri="https://voicevox.hiroshiba.jp" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Status.Value}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="{Binding IsIndeterminate.Value}"
                             Maximum="{Binding ProgressMax.Value}"
                             Value="{Binding Progress.Value}" />
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Error.Value}" TextWrapping="Wrap" />
            </StackPanel>
        </Carousel>
        <CheckBox x:Name="NeverShowAgainCheckBox" Content="今後表示しない"
                  IsVisible="{Binding !IsCompleted.Value}" IsEnabled="{Binding !IsInstalling.Value}"
                  IsChecked="{Binding DoNotShowAgain.Value, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
