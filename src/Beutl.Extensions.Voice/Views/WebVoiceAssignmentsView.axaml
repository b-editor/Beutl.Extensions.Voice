<UserControl x:Class="Beutl.Extensions.Voice.Views.WebVoiceAssignmentsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Beutl.Extensions.Voice.ViewModels"
             x:CompileBindings="True" x:DataType="vm:WebVoiceAssignmentsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="ゆっくり音声サイトの声" FontWeight="SemiBold" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="ブラウザタブのゆっくりボイスメーカー・ゆくも!でダウンロードした音声は、読み上げ要素として追加されます。立ち絵と字幕は、声ごとに初めて追加したときに選んだものを使います。" />
        <TextBlock x:Name="NoWebVoicesText" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding !HasItems.Value}" Text="まだ割り当てた声はありません。" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding Message.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding Message.Value}" />
        <ItemsControl x:Name="WebVoiceAssignmentList" ItemsSource="{Binding Items.Value}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WebVoiceAssignmentItem">
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="変更…" Click="ChangeClick" Margin="0,0,8,0"
                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} の割り当てを変更'}" />
                                <Button Content="削除" Click="DeleteClick"
                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0} の割り当てを削除'}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
