<UserControl x:Class="Beutl.Extensions.Voice.Views.VoiceEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Beutl.Extensions.Voice.Models"
             xmlns:views="using:Beutl.Extensions.Voice.Views"
             xmlns:viewModels="using:Beutl.Extensions.Voice.ViewModels"
             x:CompileBindings="True" x:DataType="viewModels:VoiceEditorViewModel">
    <UserControl.Resources>
        <Thickness x:Key="ToolTabBarPadding">8,2,4,2</Thickness>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="8,4,8,8" ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding IsEnabled.Value}">
            <TextBlock Text="話者" Margin="0,0,0,4" />
            <TextBlock Grid.Column="2" Text="スタイル" Margin="0,0,0,4" />
            <ComboBox x:Name="VoiceSelector" Grid.Row="1" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="話者"
                      ItemsSource="{Binding Voice.Value}" SelectedItem="{Binding SelectedVoice.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:VoiceMetadata">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="StyleSelector" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="スタイル"
                      ItemsSource="{Binding SelectedVoice.Value.Styles}" SelectedItem="{Binding SelectedStyle.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:VoiceStyle">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Expander x:Name="TuningExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                  HorizontalAlignment="Stretch" Header="調声" IsEnabled="{Binding IsEnabled.Value}">
            <StackPanel Margin="8,4" Spacing="0">
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="話速" />
                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="話速" Value="{Binding SpeedScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SpeedScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="音高" />
                    <Slider Grid.Column="1" Minimum="-0.15" Maximum="0.15" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="音高" Value="{Binding PitchScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PitchScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="抑揚" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="抑揚" Value="{Binding IntonationScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding IntonationScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="音量" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="音量" Value="{Binding VolumeScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumeScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="前無音" ToolTip.Tip="音声の前の無音（秒）" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="前無音（秒）" Value="{Binding PrePhonemeLength.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PrePhonemeLength.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="60,*,44">
                    <TextBlock VerticalAlignment="Center" Text="後無音" ToolTip.Tip="音声の後の無音（秒）" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="後無音（秒）" Value="{Binding PostPhonemeLength.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PostPhonemeLength.Value, StringFormat={}{0:F2}}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander x:Name="AccentExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                  HorizontalAlignment="Stretch" Header="アクセント / ピッチ" IsEnabled="{Binding IsEnabled.Value}">
            <StackPanel Margin="8" Spacing="8">
                <Button Content="テキストを解析" Command="{Binding CreateQuery}"
                        ToolTip.Tip="テキストからアクセントを解析し直します。手動のアクセント編集は置き換わります。" />
                <TextBlock IsVisible="{Binding !HasAudioQuery.Value}" Text="解析すると、発音ごとのアクセントとピッチを編集できます。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasAudioQuery.Value}">
                    <views:AccentPhrasePanel x:Name="AccentPanel" MinHeight="220"
                                             ToolTip.Tip="ドラッグでピッチを調整、バーをクリックでアクセント位置を変更"
                                             AccentPhrases="{Binding AudioQuery.Value.AccentPhrases}"
                                             AccentPhrasesChanged="OnAccentPhrasesChanged" />
                </ScrollViewer>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
