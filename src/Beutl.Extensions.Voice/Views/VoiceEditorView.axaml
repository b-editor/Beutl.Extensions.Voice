<UserControl x:Class="Beutl.Extensions.Voice.Views.VoiceEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Beutl.Extensions.Voice.Models"
             xmlns:views="using:Beutl.Extensions.Voice.Views"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModels="using:Beutl.Extensions.Voice.ViewModels"
             x:CompileBindings="True" x:DataType="viewModels:VoiceEditorViewModel">
    <UserControl.Resources>
        <Thickness x:Key="ToolTabBarPadding">8,2,4,2</Thickness>
    </UserControl.Resources>
    <StackPanel>
        <ContentControl x:Name="LocalEngineSetupHost" IsVisible="False" Margin="8" />
        <StackPanel Margin="8,4,8,0" Spacing="4">
            <TextBlock Text="エンジン" />
            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !IsConnecting.Value}">
                <ComboBox x:Name="EngineSelector" HorizontalAlignment="Stretch" AutomationProperties.Name="エンジン"
                          ItemsSource="{Binding Engines.Value}" SelectedItem="{Binding SelectedEngine.Value, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VoiceEngineConnection">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="EngineMenuButton" Grid.Column="1" Theme="{StaticResource ToolTabBarIconButtonTheme}"
                        ToolTip.Tip="エンジンの接続先" AutomationProperties.Name="エンジンの接続先">
                    <icons:FluentIcon Icon="MoreHorizontal" FontSize="16" />
                    <Button.Flyout>
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Text="インストール済みのエンジンを探す…" Click="FindLocalEnginesClick" />
                            <ui:FAMenuFlyoutItem Text="接続先を追加…" Click="AddConnectionClick" />
                            <ui:FAMenuFlyoutItem Text="接続先を編集…" Click="EditConnectionClick" IsEnabled="{Binding CanEditConnection.Value}" />
                            <ui:FAMenuFlyoutItem Text="接続確認・再読み込み" Command="{Binding ReloadEngine}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Text="接続先を削除" Command="{Binding DeleteConnection}" IsEnabled="{Binding IsExternalEngine.Value}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Text="VOICEVOX Coreをインストール…" Click="InstallCoreClick" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <TextBlock Text="{Binding SelectedEngine.Value.Location}" IsVisible="{Binding IsExternalEngine.Value}"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Margin="8,4,8,8" ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding IsEnabled.Value}">
            <TextBlock Text="話者" Margin="0,0,0,4" />
            <TextBlock Grid.Column="2" Text="スタイル" Margin="0,0,0,4" />
            <ComboBox x:Name="VoiceSelector" Grid.Row="1" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="話者"
                      ItemsSource="{Binding Voice.Value}" SelectedItem="{Binding SelectedVoice.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:VoiceMetadata">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="StyleSelector" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="スタイル"
                      ItemsSource="{Binding Styles.Value}" SelectedItem="{Binding SelectedStyle.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:VoiceStyle">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <StackPanel Margin="8,0,8,8" Spacing="4"
                    IsVisible="{Binding DictionaryNotice.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding DictionaryNotice.Value}" TextWrapping="Wrap" FontSize="12" />
            <Button Content="テキストを解析" Command="{Binding CreateQuery}" IsEnabled="{Binding !IsGenerating.Value}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Expander x:Name="TuningExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                  HorizontalAlignment="Stretch" Header="調声" IsEnabled="{Binding IsEnabled.Value}">
            <StackPanel Margin="8,4" Spacing="0">
                <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding EngineCapabilities.Value.AdjustSpeed}">
                    <TextBlock VerticalAlignment="Center" Text="話速" />
                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="話速" Value="{Binding SpeedScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SpeedScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding EngineCapabilities.Value.AdjustPitch}">
                    <TextBlock VerticalAlignment="Center" Text="音高" />
                    <Slider Grid.Column="1" Minimum="-0.15" Maximum="0.15" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="音高" Value="{Binding PitchScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PitchScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding EngineCapabilities.Value.AdjustIntonation}">
                    <TextBlock VerticalAlignment="Center" Text="{Binding EngineCapabilities.Value.IntonationLabel}" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="{Binding EngineCapabilities.Value.IntonationLabel}" Value="{Binding IntonationScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding IntonationScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding EngineCapabilities.Value.TempoDynamics}">
                    <TextBlock VerticalAlignment="Center" Text="緩急" ToolTip.Tip="話す速さの緩急の強さ" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="緩急" Value="{Binding TempoDynamicsScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TempoDynamicsScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding EngineCapabilities.Value.AdjustVolume}">
                    <TextBlock VerticalAlignment="Center" Text="音量" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="音量" Value="{Binding VolumeScale.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumeScale.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <StackPanel x:Name="AquesTalkPlayerTuning" IsVisible="{Binding IsAquesTalkPlayer.Value}">
                    <CheckBox Content="棒読み" IsChecked="{Binding AquesTalkFlatReading.Value, Mode=TwoWay}"
                              AutomationProperties.Name="棒読み" ToolTip.Tip="アクセントを付けずに平板に読みます" />
                    <Grid ColumnDefinitions="72,*,44">
                        <TextBlock VerticalAlignment="Center" Text="話速" />
                        <Slider Grid.Column="1" Minimum="50" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="話速" Value="{Binding AquesTalkSpeed.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkSpeed.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,44">
                        <TextBlock VerticalAlignment="Center" Text="音量" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="音量" Value="{Binding AquesTalkVolume.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkVolume.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding IsAquesTalk10.Value}">
                        <TextBlock VerticalAlignment="Center" Text="高さ" />
                        <Slider Grid.Column="1" Minimum="20" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="高さ" Value="{Binding AquesTalkHeight.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkHeight.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding IsAquesTalk10.Value}">
                        <TextBlock VerticalAlignment="Center" Text="アクセント" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="アクセント" Value="{Binding AquesTalkAccent.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkAccent.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,44" IsVisible="{Binding IsAquesTalk10.Value}">
                        <TextBlock VerticalAlignment="Center" Text="声質" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="声質" Value="{Binding AquesTalkQuality.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkQuality.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*,44">
                        <TextBlock VerticalAlignment="Center" Text="音程" />
                        <Slider Grid.Column="1" Minimum="50" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="音程" Value="{Binding AquesTalkFrequencyScale.Value, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AquesTalkFrequencyScale.Value, StringFormat={}{0:F0}}" />
                    </Grid>
                </StackPanel>
                <Grid ColumnDefinitions="72,*,44">
                    <TextBlock VerticalAlignment="Center" Text="前無音" ToolTip.Tip="音声の前の無音（秒）" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="前無音（秒）" Value="{Binding PrePhonemeLength.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PrePhonemeLength.Value, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="72,*,44">
                    <TextBlock VerticalAlignment="Center" Text="後無音" ToolTip.Tip="音声の後の無音（秒）" />
                    <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="後無音（秒）" Value="{Binding PostPhonemeLength.Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PostPhonemeLength.Value, StringFormat={}{0:F2}}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander x:Name="AccentExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsEnabled.Value}"
                  IsVisible="{Binding EngineCapabilities.Value.EditAccent}">
            <Expander.Header>
                <Panel>
                    <TextBlock Text="アクセント / ピッチ" IsVisible="{Binding !IsAquesTalkPlayer.Value}" />
                    <TextBlock Text="アクセント" IsVisible="{Binding IsAquesTalkPlayer.Value}" />
                </Panel>
            </Expander.Header>
            <StackPanel Margin="8" Spacing="8">
                <Button Content="テキストを解析" Command="{Binding CreateQuery}"
                        ToolTip.Tip="テキストからアクセントを解析し直します。手動のアクセント編集は置き換わります。" />
                <Panel IsVisible="{Binding !HasAudioQuery.Value}">
                    <TextBlock IsVisible="{Binding !IsAquesTalkPlayer.Value}" Text="解析すると、発音ごとのアクセントとピッチを編集できます。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock IsVisible="{Binding IsAquesTalkPlayer.Value}" Text="VOICEVOXで解析すると、アクセントの位置を編集できます。解析しないときはAquesTalkPlayerが読みを決めます。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Panel>
                <TextBlock Text="棒読みでは、アクセントは読みに反映されません。" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsAquesTalkPlayer.Value" />
                            <Binding Path="AquesTalkFlatReading.Value" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasAudioQuery.Value}">
                    <!-- Without its pitches the panel is as tall as its accent bars. -->
                    <views:AccentPhrasePanel x:Name="AccentPanel"
                                             ShowPitch="{Binding !IsAquesTalkPlayer.Value}"
                                             IsEnabled="{Binding !IsGenerating.Value}"
                                             ToolTip.Tip="{Binding IsAquesTalkPlayer.Value, Converter={x:Static views:VoiceEditorView.AccentPanelTip}}"
                                             AccentPhrases="{Binding AudioQuery.Value.AccentPhrases}"
                                             AccentPhrasesChanged="OnAccentPhrasesChanged" AccentChanged="OnAccentChanged" />
                </ScrollViewer>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
