<UserControl x:Class="Beutl.Extensions.Voice.Views.LipSyncSelectionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:Beutl.Extensions.Voice.ViewModels"
             x:CompileBindings="True" x:DataType="vm:LipSyncSelectionViewModel">
    <Expander x:Name="LipSyncExpander" Header="口パク" HorizontalAlignment="Stretch"
              Theme="{StaticResource ToolTabExpanderTheme}">
        <Grid Margin="8" ColumnDefinitions="*,Auto">
            <ComboBox x:Name="LipSyncTemplateSelector" HorizontalAlignment="Stretch" DropDownOpened="RefreshTemplates"
                      AutomationProperties.Name="生成時の口パク連携"
                      ToolTip.Tip="PSD立ち絵を保存したテンプレートから選択します。同じPSDファイルの立ち絵がシーンにあれば連携し、なければテンプレートの立ち絵を追加します。"
                      ItemsSource="{Binding Choices.Value}" SelectedItem="{Binding Selected.Value, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LipSyncChoice">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Theme="{StaticResource ToolTabBarIconButtonTheme}"
                    Command="{Binding Refresh}" ToolTip.Tip="立ち絵のテンプレートを再読み込み"
                    AutomationProperties.Name="立ち絵のテンプレートを再読み込み">
                <icons:FluentIcon Icon="ArrowClockwise" FontSize="16" />
            </Button>
        </Grid>
    </Expander>
</UserControl>
