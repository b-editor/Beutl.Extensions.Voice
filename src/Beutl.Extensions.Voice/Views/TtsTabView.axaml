<UserControl x:Class="Beutl.Extensions.Voice.Views.TtsTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:models="using:Beutl.Extensions.Voice.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Beutl.Extensions.Voice.Views"
             xmlns:viewModels="using:Beutl.Extensions.Voice.ViewModels"
             d:DesignHeight="600" d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="viewModels:TtsTabViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ui:FAInfoBar Title="VOICEVOXがインストールされていません。" Margin="8"
                              IsOpen="{Binding !IsVoiceVoxInstalled.Value}"
                              IsVisible="{Binding !IsVoiceVoxInstalled.Value}" Severity="Warning">
                    <ui:FAInfoBar.ActionButton>
                        <Button Click="DownloadVoiceVox">インストール</Button>
                    </ui:FAInfoBar.ActionButton>
                </ui:FAInfoBar>
                <StackPanel IsEnabled="{Binding !IsGenerating.Value}">
                    <TextBox x:Name="SpeechTextBox" MinHeight="112" MaxHeight="200" Margin="8"
                             VerticalContentAlignment="Top" AcceptsReturn="True"
                             PlaceholderText="読み上げるテキストを入力"
                             AutomationProperties.Name="読み上げるテキスト"
                             Text="{Binding Text.Value, Mode=TwoWay}" TextWrapping="Wrap" />

                    <TextBlock Margin="8,4,8,0" Text="プリセット" />
                    <Grid Margin="8,4,8,0" ColumnDefinitions="*,Auto,Auto">
                        <ComboBox x:Name="PresetSelector" HorizontalAlignment="Stretch" PlaceholderText="プリセットを選択"
                                  AutomationProperties.Name="声のプリセット"
                                  ItemsSource="{Binding Presets.Value}" SelectedItem="{Binding SelectedPreset.Value, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:VoicePreset">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Settings.SpeakerName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="ApplyPresetButton" Grid.Column="1" Margin="4,0,0,0" Padding="8,4"
                                Content="適用" Command="{Binding ApplyPreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                        <Button x:Name="PresetMenuButton" Grid.Column="2"
                                Theme="{StaticResource ToolTabBarIconButtonTheme}"
                                ToolTip.Tip="プリセットの管理" AutomationProperties.Name="プリセットの管理">
                            <icons:FluentIcon Icon="MoreHorizontal" FontSize="16" />
                            <Button.Flyout>
                                <ui:FAMenuFlyout>
                                    <ui:FAMenuFlyoutItem Text="現在の設定を保存…" Click="SavePresetClick" />
                                    <ui:FAMenuFlyoutItem Text="現在の設定で更新" Command="{Binding UpdatePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                    <ui:FAMenuFlyoutItem Text="保存値との差分…" Click="ShowPresetDetails" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                    <ui:FAMenuFlyoutSeparator />
                                    <ui:FAMenuFlyoutItem Text="名前を変更…" Click="RenamePresetClick" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                    <ui:FAMenuFlyoutItem Text="複製" Command="{Binding DuplicatePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                    <ui:FAMenuFlyoutItem Text="削除" Command="{Binding DeletePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                    <ui:FAMenuFlyoutSeparator />
                                    <ui:FAMenuFlyoutItem Text="再読み込み" Command="{Binding RefreshPresets}" />
                                </ui:FAMenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock Margin="8,4" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding PresetMessage.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PresetMessage.Value}" />

                    <Grid Margin="8,4,8,8" ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding IsEnabled.Value}">
                        <TextBlock Text="話者" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="2" Text="スタイル" Margin="0,0,0,4" />
                        <ComboBox x:Name="VoiceSelector" Grid.Row="1" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="話者"
                                  ItemsSource="{Binding Voice.Value}" SelectedItem="{Binding SelectedVoice.Value, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:VoiceMetadata">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="StyleSelector" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="スタイル"
                                  ItemsSource="{Binding SelectedVoice.Value.Styles}" SelectedItem="{Binding SelectedStyle.Value, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:VoiceStyle">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Expander x:Name="TuningExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                              HorizontalAlignment="Stretch" Header="調声" IsEnabled="{Binding IsEnabled.Value}">
                        <StackPanel Margin="8,4" Spacing="0">
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="話速" />
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="話速" Value="{Binding SpeedScale.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SpeedScale.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="音高" />
                                <Slider Grid.Column="1" Minimum="-0.15" Maximum="0.15" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="音高" Value="{Binding PitchScale.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PitchScale.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="抑揚" />
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="抑揚" Value="{Binding IntonationScale.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding IntonationScale.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="音量" />
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="音量" Value="{Binding VolumeScale.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumeScale.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="前無音" ToolTip.Tip="音声の前の無音（秒）" />
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="前無音（秒）" Value="{Binding PrePhonemeLength.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PrePhonemeLength.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*,44">
                                <TextBlock VerticalAlignment="Center" Text="後無音" ToolTip.Tip="音声の後の無音（秒）" />
                                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.5" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="後無音（秒）" Value="{Binding PostPhonemeLength.Value, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PostPhonemeLength.Value, StringFormat={}{0:F2}}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="AccentExpander" Theme="{StaticResource ToolTabExpanderTheme}"
                              HorizontalAlignment="Stretch" Header="アクセント / ピッチ" IsEnabled="{Binding IsEnabled.Value}">
                        <StackPanel Margin="8" Spacing="8">
                            <Button Content="テキストを解析" Command="{Binding CreateQuery}"
                                    ToolTip.Tip="テキストからアクセントを解析し直します。手動のアクセント編集は置き換わります。" />
                            <TextBlock IsVisible="{Binding !HasAudioQuery.Value}" Text="解析すると、発音ごとのアクセントとピッチを編集できます。"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasAudioQuery.Value}">
                                <views:AccentPhrasePanel x:Name="AccentPanel" MinHeight="220"
                                                         ToolTip.Tip="ドラッグでピッチを調整、バーをクリックでアクセント位置を変更"
                                                         AccentPhrases="{Binding AudioQuery.Value.AccentPhrases}"
                                                         AccentPhrasesChanged="OnAccentPhrasesChanged" />
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsGenerating.Value}" />
                <Grid Margin="8" ColumnDefinitions="*,8,*" IsEnabled="{Binding IsEnabled.Value}">
                    <Button x:Name="PreviewButton" Content="試聴" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding Play}" IsEnabled="{Binding !IsGenerating.Value}" />
                    <Button x:Name="AddSpeechButton" Grid.Column="2" Content="追加" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding Generate}" IsEnabled="{Binding !IsGenerating.Value}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
