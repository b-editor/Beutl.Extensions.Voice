<UserControl x:Class="Beutl.Extensions.Voice.Views.TtsTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:models="using:Beutl.Extensions.Voice.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:Beutl.Controls"
             xmlns:views="using:Beutl.Extensions.Voice.Views"
             xmlns:viewModels="using:Beutl.Extensions.Voice.ViewModels"
             d:DesignHeight="600" d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="viewModels:TtsTabViewModel"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Thickness x:Key="ToolTabBarPadding">8,2,4,2</Thickness>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <controls:ToolTabBar>
            <TabStrip x:Name="PageTabs" Classes="toolTabNavigation" SelectionChanged="PageChanged"
                      SelectedIndex="{Binding SelectedPage.Value, Mode=TwoWay}">
                <TabStripItem Content="読み上げ" />
                <TabStripItem Content="台本" />
                <TabStripItem Content="設定" />
            </TabStrip>
        </controls:ToolTabBar>
        <Carousel Grid.Row="1" SelectedIndex="{Binding #PageTabs.SelectedIndex}" PageTransition="{x:Null}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <views:CoreInstallPromptView x:Name="CoreInstallPrompt" IsVisible="{Binding ShowCoreInstallPrompt.Value}" />
                        <StackPanel IsEnabled="{Binding !IsGenerating.Value}">
                            <TextBox x:Name="SpeechTextBox" MinHeight="112" MaxHeight="200" Margin="8"
                                     VerticalContentAlignment="Top" AcceptsReturn="True"
                                     PlaceholderText="読み上げるテキストを入力"
                                     AutomationProperties.Name="読み上げるテキスト"
                                     Text="{Binding Text.Value, Mode=TwoWay}" TextWrapping="Wrap" />

                            <TextBlock Margin="8,4,8,0" Text="プリセット" />
                            <Grid Margin="8,4,8,0" ColumnDefinitions="*,Auto,Auto">
                                <ComboBox x:Name="PresetSelector" HorizontalAlignment="Stretch" PlaceholderText="プリセットを選択"
                                          AutomationProperties.Name="声のプリセット"
                                          ItemsSource="{Binding Presets.Value}" SelectedItem="{Binding SelectedPreset.Value, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:VoicePreset">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Settings.SpeakerName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="ApplyPresetButton" Grid.Column="1" Margin="4,0,0,0" Padding="8,4"
                                        Content="適用" Command="{Binding ApplyPreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                <Button x:Name="PresetMenuButton" Grid.Column="2"
                                        Theme="{StaticResource ToolTabBarIconButtonTheme}"
                                        ToolTip.Tip="プリセットの管理" AutomationProperties.Name="プリセットの管理">
                                    <icons:FluentIcon Icon="MoreHorizontal" FontSize="16" />
                                    <Button.Flyout>
                                        <ui:FAMenuFlyout>
                                            <ui:FAMenuFlyoutItem Text="現在の設定を保存…" Click="SavePresetClick" />
                                            <ui:FAMenuFlyoutItem Text="現在の設定で更新" Command="{Binding UpdatePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                            <ui:FAMenuFlyoutItem Text="保存値との差分…" Click="ShowPresetDetails" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                            <ui:FAMenuFlyoutSeparator />
                                            <ui:FAMenuFlyoutItem Text="名前を変更…" Click="RenamePresetClick" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                            <ui:FAMenuFlyoutItem Text="複製" Command="{Binding DuplicatePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                            <ui:FAMenuFlyoutItem Text="削除" Command="{Binding DeletePreset}" IsEnabled="{Binding HasSelectedPreset.Value}" />
                                            <ui:FAMenuFlyoutSeparator />
                                            <ui:FAMenuFlyoutItem Text="再読み込み" Command="{Binding RefreshPresets}" />
                                        </ui:FAMenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Margin="8,4" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding PresetMessage.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PresetMessage.Value}" />

                            <views:VoiceEditorView x:Name="VoiceEditor" />
                            <views:LipSyncSelectionView x:Name="GenerationLipSync" DataContext="{Binding LipSync}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsGenerating.Value}" />
                        <Grid Margin="8" ColumnDefinitions="*,8,*" IsEnabled="{Binding IsEnabled.Value}">
                            <Button x:Name="PreviewButton" Content="試聴" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding Play}" IsEnabled="{Binding !IsGenerating.Value}" />
                            <Button x:Name="AddSpeechButton" Grid.Column="2" Content="追加" Classes="accent"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding Generate}" IsEnabled="{Binding !IsGenerating.Value}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <views:ScriptImportView x:Name="ScriptPage" DataContext="{Binding Script}" />
            <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
                <views:LocalEngineSetupView x:Name="EngineSetup" Margin="8" ShowCloseButton="False" EngineConnected="EngineConnected" />
            </ScrollViewer>
        </Carousel>
    </Grid>
</UserControl>
